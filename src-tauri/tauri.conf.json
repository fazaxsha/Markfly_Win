{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markfly",
  "version": "0.4.1",
  "identifier": "com.markfly.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markfly",
        "width": 900,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 ws://127.0.0.1:5173; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Minimal markdown viewer",
    "longDescription": "Markfly previews Markdown documents with GitHub-styled rendering, raw source toggle, auto-reload and safe URL import. Built with Rust and Tauri for Windows.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "markdn"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "rank": "Owner"
      }
    ]
  }
}
